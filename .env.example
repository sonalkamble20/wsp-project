# Environment variables for FitTrak
# Copy this file to .env and fill in the values.

# MongoDB connection string (use MongoDB Atlas for production)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fittrak?retryWrites=true&w=majority

# JWT signing secret — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_string

# Server port (Render sets this automatically)
PORT=5000

# Set to "production" on Render
NODE_ENV=production
