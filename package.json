{
  "name": "fittrak-server",
  "version": "1.0.0",
  "description": "FitTrak fullstack fitness tracker — Node/Express/MongoDB backend",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node server/seed.js && node index.js",
    "dev": "concurrently \"nodemon index.js\" \"npm run dev --prefix client\"",
    "build": "npm install --prefix client && npm run build --prefix client",
    "seed": "node server/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=18"
  }
}
